{
    "name": "restruct/silverstripe-mfa-bundle",
    "description": "Multi-factor authentication for the Silverstripe CMS in one install: authenticator apps (TOTP) and security keys or passkeys (WebAuthn), required for CMS users with a grace period",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "silverstripe-cms",
        "mfa",
        "2fa",
        "multi-factor-authentication",
        "totp",
        "webauthn",
        "passkeys",
        "authentication",
        "security"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5.4 || ^6",
        "silverstripe/admin": "^2 || ^3",
        "silverstripe/siteconfig": "^5.4 || ^6",
        "silverstripe/mfa": "^5 || ^6",
        "silverstripe/totp-authenticator": "^5 || ^6",
        "silverstripe/webauthn-authenticator": "^5 || ^6"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\MFABundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\MFABundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
